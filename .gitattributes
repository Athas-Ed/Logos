# Normalize line endings to LF on checkout
* text=auto eol=lf

# Windows batch/cmd files — cmd.exe REQUIRES CRLF, LF-only breaks execution
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell scripts — Windows-native, CRLF safest for PS 5.1 with Chinese/BOM
*.ps1 text eol=crlf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.lock binary
