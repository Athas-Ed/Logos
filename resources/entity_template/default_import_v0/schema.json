{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logos.local/schemas/import_batch_default_import_v0.json",
  "title": "SettingImportBatch",
  "type": "object",
  "required": ["batch_id", "units"],
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "批次 ID（UUID / ULID 等唯一字符串）"
    },
    "source_label": {
      "type": "string",
      "description": "可选：稿源标签，便于溯源"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/unit" }
    }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["classification", "slug", "body_markdown"],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["character", "location", "item", "faction", "lore_note"]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "description": "文件名段：小写字母数字起头，仅 a-z0-9_-，总长≤63"
        },
        "title": { "type": "string" },
        "body_markdown": {
          "type": "string",
          "minLength": 1,
          "description": "正文 Markdown（front matter 之外由渲染规格落位）"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "additionalProperties": false,
            "properties": {
              "verbatim_quote": { "type": "string" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
