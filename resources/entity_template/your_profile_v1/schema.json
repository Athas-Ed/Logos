{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logos.local/schemas/import_batch_your_profile_v1.json",
  "title": "SettingImportBatch",
  "description": "8 分类设定导入批次。YAML 头字段（aliases/tags/relations）与 body 分离设计",
  "type": "object",
  "required": ["batch_id", "units"],
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "批次唯一 ID（UUID / ULID 等）"
    },
    "source_label": {
      "type": "string",
      "description": "稿源标签，便于溯源"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/unit" }
    }
  },
  "definitions": {
    "unit": {
      "type": "object",
      "required": ["classification", "slug", "body_markdown"],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["character", "location", "faction", "item", "event", "concept", "race", "timeline"],
          "description": "实体分类，决定渲染路径与 front matter 类型标签"
        },
        "slug": {
          "type": "string",
          "pattern": "^[^\\s/\\\\?%*:\"<>|]{1,64}$",
          "description": "文件名段：汉字、字母、数字等（除 \\ / ? % * : \" < > | 和空白），长度 1-64"
        },
        "title": {
          "type": "string",
          "description": "展示用名称；无则渲染时用 slug 代替"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "别名/曾用名列表（写入 front matter）"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "标签/关键词列表（写入 front matter，便于检索与分类）"
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/definitions/relation" },
          "description": "实体间关系列表（写入 front matter，KG 核心数据）"
        },
        "body_markdown": {
          "type": "string",
          "minLength": 1,
          "description": "叙事正文（Markdown）。YAML 头之外的全部内容，每个实体独有的描述"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "additionalProperties": false,
            "properties": {
              "verbatim_quote": { "type": "string" },
              "message": { "type": "string", "minLength": 1 }
            }
          },
          "description": "修改建议列表（供人审参考，不写入最终 KSFS 实体）"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": ["target_slug", "type"],
      "additionalProperties": false,
      "properties": {
        "target_slug": {
          "type": "string",
          "pattern": "^[^\\s/\\\\?%*:\"<>|]{1,64}$",
          "description": "目标实体的 slug（同批次或 KSFS 中已有）"
        },
        "target_title": {
          "type": "string",
          "description": "目标实体展示名（可读提示，非正式键）"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "关系类型，如 member_of、ally、located_in、owns、created_by、part_of、precedes 等"
        },
        "description": {
          "type": "string",
          "description": "关系说明（可选，补充上下文）"
        }
      }
    }
  }
}
