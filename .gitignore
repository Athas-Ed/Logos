# 本地与密钥（统一走 config/local.yaml，不再使用根目录 .env）
config/local.yaml
config/secrets.yaml
# 若有人仍习惯自建 .env，忽略以免误提交
.env
.env.local

# 个人创作与工作区（可阅览修改的 KSFS/LKC/未来 KG 产物等，不上传 GitHub）
workspace/

# 兼容旧约定（若仍使用可保留）
user_data/

# 工具向模型权重（自行拷贝，不入库）
models/tooling/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 索引与日志（默认路径，可由 Config 改）
.index/
logs/

# 常见本地数据（路径可按实现调整）
*.sqlite
*.sqlite3
