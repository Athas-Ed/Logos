# 本地 KSFS 脚本工具集（正式打包前暂不提交）
scripts/KSFS工具/

# 作者自用开发文档（对外介绍见 docs/；本机可保留任意草稿）
original_docs/

# 本地与密钥（统一走 config/local.yaml，不再使用根目录 .env）
config/local.yaml
config/secrets.yaml
# 若有人仍习惯自建 .env，忽略以免误提交
.env
.env.local

# 开发用 KSFS 示例树（本机保留；不入库）
/example_ksfs/**

# KSFS 事实源：个人创作内容不入库，仅保留说明
/resources/ksfs/**
!/resources/ksfs/README.md

# 工作区：草稿、会话缓存、setting_entry 等（仅保留说明）
/workspace/**
!/workspace/README.md
!/workspace/setting_entry/
!/workspace/setting_entry/README.md

# 兼容旧约定（若仍使用可保留）
user_data/

# 工具向模型权重（自行拷贝，不入库）
models/tooling/

# Electron 壳（构建产物与依赖）
src/electron/dist/
src/electron/node_modules/
src/electron/release/

# GUI（构建产物、依赖、Playwright 输出）
src/gui/node_modules/
src/gui/dist/
src/gui/playwright-report/
src/gui/test-results/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 索引与日志（默认路径，可由 Config 改）
.index/
# logs：提交 README 与 daily/maint 占位；忽略所有 .log 落盘文件（见 logs/README.md）
logs/**/*.log

# 常见本地数据（路径可按实现调整）
*.sqlite
*.sqlite3

# 检索基准历史
.benchmark_history/

# Windows 目录元数据
desktop.ini
