# 本地与密钥（统一走 config/local.yaml，不再使用根目录 .env）
config/local.yaml
config/secrets.yaml
# 若有人仍习惯自建 .env，忽略以免误提交
.env
.env.local

# 个人创作与工作区（默认全部忽略；仅例外提交两份说明，见 KSFS开发.md §2）
/workspace/**
!/workspace/README.md
!/workspace/setting_entry/
!/workspace/setting_entry/README.md

# 兼容旧约定（若仍使用可保留）
user_data/

# 工具向模型权重（自行拷贝，不入库）
models/tooling/

# Electron 壳（构建产物与依赖）
src/electron/dist/
src/electron/node_modules/
src/electron/release/

# GUI（构建产物、依赖、Playwright 输出）
src/gui/node_modules/
src/gui/dist/
src/gui/playwright-report/
src/gui/test-results/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 索引与日志（默认路径，可由 Config 改）
.index/
# logs：提交 README 与 daily/maint 占位；忽略所有 .log 落盘文件（见 logs/README.md）
logs/**/*.log

# 常见本地数据（路径可按实现调整）
*.sqlite
*.sqlite3

# Windows 目录元数据
desktop.ini
